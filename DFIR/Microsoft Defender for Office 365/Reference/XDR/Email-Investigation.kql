// Objective: Investigate email communications, subjects, recipients and attachments.
// Platform: Microsoft Defender XDR Advanced Hunting (Timestamp, not TimeGenerated).
// Scope: observed Defender for Office 365 telemetry, NOT complete mailbox contents.
// Grounding and tenant execution evidence: Email-Verification.md in this directory.
// ----- Part 1: Investigation parameters -----
let StartTime = ago(30d);
let EndTime = now();
let TargetUser = "";                 // Exact sender/envelope sender/recipient; empty = all.
let TargetNetworkMessageId = "";     // Exact Microsoft 365 message identifier.
let SubjectContains = "";            // Case-insensitive substring.
let Direction = "";                  // Inbound, Outbound, Intra-org; empty = all.
let ExternalOnly = false;            // Uses recorded direction, not domain guessing.
let AttachmentSHA256 = "";           // Exact attachment hash; applied after enrichment.
let AttachmentNameContains = "";     // Case-insensitive attachment filename substring.
let OutputMode = "Timeline";         // Timeline or Evidence (case-sensitive).
let MaxRows = 1000;                  // Applies to timeline ONLY; evidence uses all scoped rows.
// ----- Part 2: Message-recipient scope; latest observed state plus first/last timestamps -----
let Messages = materialize(
    EmailEvents
    | where Timestamp between (StartTime .. EndTime)
    | where isempty(TargetUser) or SenderFromAddress =~ TargetUser
        or SenderMailFromAddress =~ TargetUser or RecipientEmailAddress =~ TargetUser
    | where isempty(TargetNetworkMessageId) or NetworkMessageId == TargetNetworkMessageId
    | where isempty(SubjectContains) or Subject contains SubjectContains
    | where isempty(Direction) or EmailDirection =~ Direction
    | where not(ExternalOnly) or EmailDirection in~ ("Inbound", "Outbound")
    | summarize FirstObserved=min(Timestamp), LastObserved=max(Timestamp),
        ObservedEventCount=count(), arg_max(Timestamp, *)
        by NetworkMessageId, RecipientEmailAddress
    | extend RecipientKey=tolower(RecipientEmailAddress),
        CommunicationScope=case(EmailDirection =~ "Inbound", "External inbound",
            EmailDirection =~ "Outbound", "External outbound",
            EmailDirection =~ "Intra-org", "Internal", "Unknown")
);
// ----- Part 3: Preserve correlated attachment objects; no cross-recipient fan-out -----
let Attachments = EmailAttachmentInfo
    | where Timestamp between (StartTime .. EndTime)
    | where NetworkMessageId in (Messages | project NetworkMessageId)
    | extend RecipientKey=tolower(RecipientEmailAddress)
    | summarize AttachmentRecords=count(), AttachmentNames=make_set(FileName, 500),
        AttachmentHashes=make_set(SHA256, 500),
        AttachmentDetails=make_set(bag_pack("FileName", FileName, "FileType", FileType,
            "SHA256", SHA256, "FileSize", FileSize, "ThreatTypes", ThreatTypes,
            "ThreatNames", ThreatNames, "Timestamp", Timestamp), 500),
        AttachmentFilterMatches=countif(
            (isempty(AttachmentSHA256) or SHA256 =~ AttachmentSHA256)
            and (isempty(AttachmentNameContains) or FileName contains AttachmentNameContains))
        by NetworkMessageId, RecipientKey;
// ----- Part 4: Message-level URL metadata; aggregate before joining -----
let URLs = EmailUrlInfo
    | where Timestamp between (StartTime .. EndTime)
    | where NetworkMessageId in (Messages | project NetworkMessageId)
    | summarize URLRecords=count(), URLDetails=make_set(
        bag_pack("Url", Url, "Domain", UrlDomain, "Location", UrlLocation), 500)
        by NetworkMessageId;
// ----- Part 5: Recipient-specific post-delivery actions (not evidence of reading) -----
let PostDelivery = EmailPostDeliveryEvents
    | where Timestamp between (StartTime .. EndTime)
    | where NetworkMessageId in (Messages | project NetworkMessageId)
    | extend RecipientKey=tolower(RecipientEmailAddress)
    | summarize PostDeliveryRecords=count(), PostDeliveryDetails=make_set(
        bag_pack("Timestamp", Timestamp, "Action", Action, "ActionType", ActionType,
            "Result", ActionResult, "DeliveryLocation", DeliveryLocation), 500)
        by NetworkMessageId, RecipientKey;
// ----- Part 6: Join enrichment; retain messages without attachments or URLs -----
let Investigation = materialize(
    Messages
    | join kind=leftouter Attachments on NetworkMessageId, RecipientKey
    | join kind=leftouter URLs on NetworkMessageId
    | join kind=leftouter PostDelivery on NetworkMessageId, RecipientKey
    | extend AttachmentRecords=coalesce(AttachmentRecords, 0),
        URLRecords=coalesce(URLRecords, 0), PostDeliveryRecords=coalesce(PostDeliveryRecords, 0)
    | where (isempty(AttachmentSHA256) and isempty(AttachmentNameContains))
        or AttachmentFilterMatches > 0
    | extend AttachmentEvidence=case(AttachmentRecords > 0, "Metadata correlated",
        AttachmentCount > 0, "Declared attachment; metadata missing in scope",
        "No attachment declared")
    | project Timestamp, FirstObserved, LastObserved, ObservedEventCount,
        NetworkMessageId, InternetMessageId, CommunicationScope, EmailDirection,
        SenderFromAddress, SenderMailFromAddress, SenderFromDomain, SenderIPv4, SenderIPv6,
        RecipientEmailAddress, Subject, DeliveryAction, DeliveryLocation,
        ThreatTypes, ThreatNames, DetectionMethods, AuthenticationDetails,
        AttachmentCount, AttachmentRecords, AttachmentEvidence, AttachmentNames,
        AttachmentHashes, AttachmentDetails, UrlCount, URLRecords, URLDetails,
        PostDeliveryRecords, PostDeliveryDetails
);
// ----- Part 7: Evidence covers the entire scope; timeline is explicitly bounded -----
union
    (Investigation | where OutputMode == "Timeline" | top MaxRows by Timestamp desc),
    (Investigation | where OutputMode == "Evidence"
     | summarize MessageRecipientRows=count(),
        SenderEvidence=countif(isnotempty(SenderFromAddress)),
        EnvelopeSenderEvidence=countif(isnotempty(SenderMailFromAddress)),
        RecipientEvidence=countif(isnotempty(RecipientEmailAddress)),
        SubjectEvidence=countif(isnotempty(Subject)),
        ExternalInbound=countif(EmailDirection =~ "Inbound"),
        ExternalOutbound=countif(EmailDirection =~ "Outbound"),
        InternalMessages=countif(EmailDirection =~ "Intra-org"),
        DeclaredAttachments=countif(AttachmentCount > 0),
        CorrelatedAttachmentMessages=countif(AttachmentRecords > 0),
        MissingAttachmentMetadata=countif(AttachmentCount > 0 and AttachmentRecords == 0),
        CorrelatedURLMessages=countif(URLRecords > 0),
        CorrelatedPostDeliveryMessages=countif(PostDeliveryRecords > 0)
      | where OutputMode == "Evidence"
     | extend Output="Evidence", EvidenceStart=StartTime, EvidenceEnd=EndTime)