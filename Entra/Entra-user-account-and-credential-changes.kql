// User Identity > Entra user account, password and MFA changes
// Objective: Shows changes to Entra ID user accounts and their sign-in credentials: account updates, password resets and self-service password reset steps,
// MFA and security info registration or removal, passkeys, passwordless phone sign-in and session revocation, with who made the change, the account it was made to, the result and the changed properties.
// Raw events, newest first. Source: AuditLogs (Entra ID audit logs), category UserManagement plus any password operation.
//
// ----- Part 0: Analyst-Driven Targeting (Optional) -----
// Leave these empty to return all results (all users, all operations, all results).
//
let StartTime = ago(30d);               // Example: datetime(2026-10-14T00:00:00Z)
let EndTime = now();                    // Example: datetime(2026-10-14T23:59:59Z)
let TargetUsers = dynamic([]);          // Example: ["user@contoso.com"] (matches the person who made the change, or the user account it was made to)
let TargetOperations = dynamic([]);     // Example: ["Update user", "registered security info", "password"] (case-insensitive whole-word match on the operation name)
let TargetResults = dynamic([]);        // Example: ["failure"] (success, failure, clientError)
//
// ----- Part 1: Filter Entra user account and credential events -----
//
AuditLogs
| where TimeGenerated between (StartTime .. EndTime)
| where Category == "UserManagement" or OperationName has "password"
| extend InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName),
    InitiatedByApp = tostring(InitiatedBy.app.displayName),
    InitiatorIPAddress = tostring(InitiatedBy.user.ipAddress),
    AffectedUser = tostring(TargetResources[0].userPrincipalName),
    AffectedObject = tostring(TargetResources[0].displayName),
    AffectedType = tostring(TargetResources[0].type),
    ChangedProperties = TargetResources[0].modifiedProperties
| where (array_length(TargetUsers) == 0 or InitiatedByUser in~ (TargetUsers) or AffectedUser in~ (TargetUsers))
| where (array_length(TargetOperations) == 0 or OperationName has_any (TargetOperations))
| where (array_length(TargetResults) == 0 or Result in~ (TargetResults))
//
// ----- Part 2: Output -----
//
| project TimeGenerated, InitiatedByUser, InitiatedByApp, InitiatorIPAddress, OperationName, Result, ResultReason,
    AffectedUser, AffectedObject, AffectedType, ChangedProperties, AdditionalDetails, LoggedByService, CorrelationId
| top 1000 by TimeGenerated desc
